LOW_END_FFMPEG = 'ffmpeg -i "{}" -progress "{}" -nostats -loglevel warning -c copy -map 0:v -map 0:a -map 0:s -metadata title="GenDubs [t.me/GenDubs]" -metadata:s:s title="[Pirate_Flick]" -metadata:s:a title="[Pirate_Flick]" -metadata:s:v title="[Pirate_Flick]" "{}" -y'

FFCODE_HDRi = 'ffmpeg -i "{}" -progress "{}" -nostats -loglevel warning -c copy -map 0:v -map 0:a -map 0:s -metadata title="MirageIndex [t.me/MirageIndex]" -metadata:s:s title="[MirageIndex]" -metadata:s:a title="[MirageIndex]" -metadata:s:v title="[MirageIndex]" "{}" -y'

FFCODE_1080 = 'ffmpeg -i "{}" -progress "{}" -nostats -loglevel warning -map 0:v -map 0:a -map 0:s? -c:v libx264 -crf 25 -c:s copy -pix_fmt yuv420p -s 1920x1080 -c:a libopus -b:a 96k -ac 2 -preset veryfast -threads 0 -metadata title="MirageIndex [t.me/MirageIndex]" -metadata:s:s title="[MirageIndex]" -metadata:s:a title="[MirageIndex]" -metadata:s:v title="[MirageIndex]" -movflags +faststart "{}" -y'

FFCODE_720 = 'ffmpeg -i "{}" -progress "{}" -nostats -loglevel warning -map 0:v -map 0:a -map 0:s? -c:v libx264 -crf 26 -c:s copy -pix_fmt yuv420p -s 1280x720 -c:a libopus -b:a 64k -ac 2 -preset veryfast -threads 0 -metadata title="MirageIndex [t.me/MirageIndex]" -metadata:s:s title="[MirageIndex]" -metadata:s:a title="[MirageIndex]" -metadata:s:v title="[MirageIndex]" -movflags +faststart "{}" -y'

FFCODE_480 = 'ffmpeg -i "{}" -progress "{}" -nostats -loglevel warning -map 0:v -map 0:a -map 0:s? -c:v libx264 -crf 27 -c:s copy -pix_fmt yuv420p -s 854x480 -c:a libopus -b:a 42k -ac 2 -preset veryfast -threads 0 -metadata title="MirageIndex [t.me/MirageIndex]" -metadata:s:s title="[MirageIndex]" -metadata:s:a title="[MirageIndex]" -metadata:s:v title="[MirageIndex]" -movflags +faststart "{}" -y'

FFCODE_360 = 'ffmpeg -i "{}" -progress "{}" -nostats -loglevel warning -vf "drawtext=text=\'GenAnimeOfc\':fontcolor=white@0.3:fontsize=14:x=5:y=5" -map 0:v -map 0:a -map 0:s -c:v libx264 -crf 29 -c:s copy -pix_fmt yuv420p -s 640x360 -c:a libopus -b:a 35k -preset veryfast -threads 2 -metadata title="GenAnimeOfc [t.me/GenAnimeOfc]" "{}" -y'

